# AeroVault environment — copy to .env and fill in secrets.
# Never commit .env.

# Runtime
AEROVAULT_ENV=dev
AEROVAULT_DATA_DIR=/data

# LLM provider (OpenAI default; LiteLLM-compatible)
AEROVAULT_OPENAI_API_KEY=
# Optional provider profiles (Phase 3)
# AEROVAULT_AZURE_API_KEY=
# AEROVAULT_AZURE_API_BASE=
# AEROVAULT_OLLAMA_API_BASE=http://host.docker.internal:11434

# Default models (Phase 3)
# AEROVAULT_CHAT_MODEL=gpt-4o-mini
# AEROVAULT_EMBEDDING_MODEL=text-embedding-3-small

# Frontend dev proxy target (inside compose network)
VITE_API_PROXY_TARGET=http://backend:8000
